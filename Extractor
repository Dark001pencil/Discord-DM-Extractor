    /* ====================================================================
       ========================= PAUSE WAIT ===============================
       ==================================================================== */


    async function waitWhilePaused() {

        while (
            STATE.paused &&
            !STATE.stopped
        ) {

            updateGui();

            await sleep(
                500
            );
        }
    }


    /* ====================================================================
       =========================== ADAPTIVE WAIT ==========================
       ==================================================================== */


    async function adaptiveWait(
        milliseconds
    ) {

        let remaining =
            milliseconds;


        while (
            remaining > 0 &&
            !STATE.stopped
        ) {

            if (
                STATE.paused
            ) {

                setStatus(
                    "Paused — waiting for RESUME..."
                );


                await waitWhilePaused();


                if (
                    STATE.stopped
                ) {

                    return;
                }
            }


            const step =
                Math.min(
                    1000,
                    remaining
                );


            await sleep(
                step
            );


            remaining -=
                step;


            if (
                remaining > 0 &&
                !STATE.paused
            ) {

                setStatus(
                    `Waiting ${Math.ceil(
                        remaining / 1000
                    )}s before next page...`
                );


                updateGui();
            }
        }
    }


    /* ====================================================================
       ======================= WAIT FOR PAGE CHANGE =======================
       ==================================================================== */


    async function waitForPageChange(
        previousSignature
    ) {

        const started =
            Date.now();


        while (
            Date.now() -
                started <
            CONFIG.pageLoadTimeoutMs
        ) {

            if (
                STATE.stopped
            ) {

                return {
                    stopped:
                        true
                };
            }


            if (
                !getSearchSection()
            ) {

                return {
                    searchDisappeared:
                        true
                };
            }


            const signature =
                getPageSignature();


            if (
                signature &&
                signature !==
                    previousSignature
            ) {

                return {

                    changed:
                        true,

                    loadMs:
                        Date.now() -
                        started
                };
            }


            await sleep(
                500
            );
        }


        return {
            timeout:
                true
        };
    }


    /* ====================================================================
       ======================= ADAPTIVE FEEDBACK ==========================
       ==================================================================== */


    function handleSuccessfulPage(
        loadMs,
        cycleMs
    ) {

        STATE.currentPageLoadMs =
            loadMs;


        STATE.throttleStrikes =
            0;


        addCycleSample(
            cycleMs
        );


        /*
           Healthy page.
        */

        if (
            loadMs <=
            CONFIG.slowPageLoadMs
        ) {

            STATE.successfulPages++;


            if (
                STATE.successfulPages >=
                CONFIG.successfulPagesBeforeSpeedup
            ) {

                STATE.currentDelay =
                    clamp(
                        STATE.currentDelay -
                            CONFIG.delayStepMs,
                        CONFIG.minimumDelayMs,
                        CONFIG.maximumDelayMs
                    );


                STATE.successfulPages =
                    0;
            }


        } else {

            /*
               Slow page.

               Immediately become more conservative.
            */

            STATE.successfulPages =
                0;


            STATE.currentDelay =
                clamp(
                    STATE.currentDelay +
                        CONFIG.delayStepMs,
                    CONFIG.minimumDelayMs,
                    CONFIG.maximumDelayMs
                );
        }


        updateGui();
    }


    /* ====================================================================
       ======================= FAILURE HANDLING ============================
       ==================================================================== */


    async function handleFailedPage(
        reason
    ) {

        STATE.throttleStrikes++;

        STATE.successfulPages =
            0;


        STATE.currentDelay =
            clamp(
                STATE.currentDelay +
                    (
                        CONFIG.delayStepMs *
                        2
                    ),
                CONFIG.minimumDelayMs,
                CONFIG.maximumDelayMs
            );


        const cooldown =
            clamp(
                CONFIG.cooldownAfterFailureMs *
                    Math.pow(
                        2,
                        STATE.throttleStrikes -
                            1
                    ),
                CONFIG.cooldownAfterFailureMs,
                CONFIG.maximumCooldownMs
            );


        STATE.paused =
            true;


        setStatus(
            `${reason} Safety pause activated.`
        );


        updateGui();


        let remaining =
            cooldown;


        while (
            remaining > 0 &&
            !STATE.stopped
        ) {

            setStatus(
                `${reason} ` +
                `Safety cooldown: ` +
                `${Math.ceil(
                    remaining / 1000
                )}s`
            );


            updateGui();


            await sleep(
                Math.min(
                    1000,
                    remaining
                )
            );


            remaining -=
                1000;
        }


        if (
            !STATE.stopped
        ) {

            setStatus(
                `${reason} ` +
                `Cooldown finished. ` +
                `Check Discord, then press RESUME.`
            );


            updateGui();
        }
    }


    /* ====================================================================
       ============================== STOP ================================
       ==================================================================== */


    async function stopCollector(
        message
    ) {

        if (
            STATE.stopped
        ) {

            return;
        }


        STATE.stopped =
            true;


        STATE.paused =
            false;


        setStatus(
            message
        );


        if (GUI) {

            GUI.pause.disabled =
                true;


            GUI.stop.disabled =
                true;
        }


        try {

            STATE.savedCount =
                await countSavedMessages();


            setStatus(
                `Stopped safely. ` +
                `${formatNumber(
                    STATE.savedCount
                )} messages stored in IndexedDB.`
            );


            updateGui();

        } catch (error) {

            console.error(
                "[DM Collector] " +
                "Final count failed:",
                error
            );
        }
    }


    /* ====================================================================
       ============================ MAIN LOOP =============================
       ==================================================================== */


    async function runCollector() {

        if (
            STATE.running
        ) {

            console.warn(
                "[DM Collector] " +
                "Collector is already running."
            );


            return;
        }


        STATE.running =
            true;


        try {

            /* ------------------------------------------------------------
               OPEN DATABASE
               ------------------------------------------------------------ */

            setStatus(
                "Opening IndexedDB..."
            );


            await openDatabase();


            STATE.savedCount =
                await countSavedMessages();


            updateGui();


            setStatus(
                `Database ready — ` +
                `${formatNumber(
                    STATE.savedCount
                )} messages already saved.`
            );


            /* ------------------------------------------------------------
               WAIT FOR SEARCH RESULTS
               ------------------------------------------------------------ */

            while (
                !STATE.stopped
            ) {

                if (
                    getSearchSection()
                ) {

                    break;
                }


                setStatus(
                    "Waiting for Discord Search Results..."
                );


                updateGui();


                await sleep(
                    1000
                );
            }


            if (
                STATE.stopped
            ) {

                return;
            }


            /* ------------------------------------------------------------
               INITIAL PAGE INFORMATION
               ------------------------------------------------------------ */

            const detectedPage =
                detectCurrentPageNumber();


            const detectedTotal =
                detectLastPageNumber();


            /*
               IMPORTANT:

               If Discord doesn't expose the active page number clearly,
               we do NOT pretend we're on page 1.

               ETA will simply remain "Calculating…" until reliable page
               information exists.
            */

            STATE.currentPage =
                detectedPage;


            STATE.totalPages =
                detectedTotal;


            STATE.totalResults =
                detectTotalResults();


            STATE.lastPageSignature =
                getPageSignature();


            updateGui();


            /* ------------------------------------------------------------
               MAIN LOOP
               ------------------------------------------------------------ */

            while (
                !STATE.stopped
            ) {

                /* --------------------------------------------------------
                   MANUAL PAUSE
                   -------------------------------------------------------- */

                await waitWhilePaused();


                if (
                    STATE.stopped
                ) {

                    break;
                }


                /* --------------------------------------------------------
                   MAKE SURE SEARCH STILL EXISTS
                   -------------------------------------------------------- */

                if (
                    !getSearchSection()
                ) {

                    if (
                        CONFIG.pauseIfSearchDisappears
                    ) {

                        STATE.paused =
                            true;


                        setStatus(
                            "Search results disappeared. Restore Discord search, then press RESUME."
                        );


                        continue;
                    }


                    break;
                }


                /* --------------------------------------------------------
                   COLLECT CURRENT PAGE
                   -------------------------------------------------------- */

                const messages =
                    extractCurrentPage();


                let saveResult;


                try {

                    saveResult =
                        await saveMessages(
                            messages
                        );

                } catch (error) {

                    console.error(
                        "[DM Collector] " +
                        "Save failed:",
                        error
                    );


                    STATE.paused =
                        true;


                    setStatus(
                        `Database error: ${
                            error.message ||
                            error
                        }`
                    );


                    continue;
                }


                STATE.savedCount =
                    await countSavedMessages();


                STATE.pagesCollectedThisRun++;


                setStatus(
                    `Page collected — ` +
                    `+${formatNumber(
                        saveResult.inserted
                    )} new, ` +
                    `${formatNumber(
                        saveResult.duplicates
                    )} already saved.`
                );


                /* --------------------------------------------------------
                   REFRESH PAGINATION INFO
                   -------------------------------------------------------- */

                const newlyDetectedPage =
                    detectCurrentPageNumber();


                const newlyDetectedTotal =
                    detectLastPageNumber();


                if (
                    newlyDetectedPage !== null
                ) {

                    STATE.currentPage =
                        newlyDetectedPage;

                } else if (
                    STATE.currentPage !== null
                ) {

                    /*
                       If Discord doesn't expose the active page on a
                       particular render, keep our last known value.
                    */
                }


                if (
                    newlyDetectedTotal !== null
                ) {

                    STATE.totalPages =
                        newlyDetectedTotal;
                }


                const totalResults =
                    detectTotalResults();


                if (
                    totalResults !== null
                ) {

                    STATE.totalResults =
                        totalResults;
                }


                updateGui();


                /* --------------------------------------------------------
                   FIND NEXT
                   -------------------------------------------------------- */

                const next =
                    getNextButton();


                if (!next) {

                    setStatus(
                        "Next button not found. Collection paused."
                    );


                    STATE.paused =
                        true;


                    continue;
                }


                if (
                    isButtonDisabled(
                        next
                    )
                ) {

                    setStatus(
                        "Reached the end of the available search pages."
                    );


                    break;
                }


                /* --------------------------------------------------------
                   WAIT BEFORE NEXT PAGE
                   -------------------------------------------------------- */

                const waitTime =
                    clamp(
                        STATE.currentDelay +
                            randomJitter(),
                        CONFIG.minimumDelayMs,
                        CONFIG.maximumDelayMs
                    );


                await adaptiveWait(
                    waitTime
                );


                if (
                    STATE.stopped
                ) {

                    break;
                }


                await waitWhilePaused();


                if (
                    STATE.stopped
                ) {

                    break;
                }


                /* --------------------------------------------------------
                   CAPTURE CURRENT PAGE SIGNATURE
                   -------------------------------------------------------- */

                const previousSignature =
                    getPageSignature();


                if (!previousSignature) {

                    await handleFailedPage(
                        "Could not identify the current search page."
                    );


                    continue;
                }


                /* --------------------------------------------------------
                   CLICK NEXT
                   -------------------------------------------------------- */

                const freshNext =
                    getNextButton();


                if (
                    !freshNext ||
                    isButtonDisabled(
                        freshNext
                    )
                ) {

                    setStatus(
                        "Next is no longer available. Collection finished."
                    );


                    break;
                }


                /*
                   Start timing the complete page cycle.

                   This includes the time between pages and Discord's
                   actual loading time, which makes the ETA much more
                   realistic.
                */

                STATE.lastCycleStartedAt =
                    Date.now();


                STATE.pageStartedAt =
                    Date.now();


                freshNext.click();


                /* --------------------------------------------------------
                   WAIT FOR NEW PAGE
                   -------------------------------------------------------- */

                const result =
                    await waitForPageChange(
                        previousSignature
                    );


                if (
                    STATE.stopped
                ) {

                    break;
                }


                /* --------------------------------------------------------
                   SUCCESS
                   -------------------------------------------------------- */

                if (
                    result.changed
                ) {

                    const cycleMs =
                        STATE.lastCycleStartedAt
                            ? Date.now() -
                                STATE.lastCycleStartedAt
                            : null;


                    /*
                       If Discord doesn't expose the current page number,
                       but we previously knew it, advance it manually.

                       This is safer than guessing page 1.
                    */

                    const detectedAfterChange =
                        detectCurrentPageNumber();


                    if (
                        detectedAfterChange !== null
                    ) {

                        STATE.currentPage =
                            detectedAfterChange;

                    } else if (
                        STATE.currentPage !== null
                    ) {

                        STATE.currentPage++;
                    }


                    const latestTotal =
                        detectLastPageNumber();


                    if (
                        latestTotal !== null
                    ) {

                        STATE.totalPages =
                            latestTotal;
                    }


                    const latestResults =
                        detectTotalResults();


                    if (
                        latestResults !== null
                    ) {

                        STATE.totalResults =
                            latestResults;
                    }


                    handleSuccessfulPage(
                        result.loadMs,
                        cycleMs
                    );


                    setStatus(
                        `Page ${
                            STATE.currentPage ??
                            "?"
                        } loaded in ` +
                        `${formatShortDuration(
                            result.loadMs
                        )} — ` +
                        `ETA ${getEtaText()}`
                    );


                    updateGui();


                    continue;
                }


                /* --------------------------------------------------------
                   SEARCH DISAPPEARED
                   -------------------------------------------------------- */

                if (
                    result.searchDisappeared
                ) {

                    await handleFailedPage(
                        "Discord search disappeared."
                    );


                    continue;
                }


                /* --------------------------------------------------------
                   TIMEOUT
                   -------------------------------------------------------- */

                if (
                    result.timeout
                ) {

                    if (
                        CONFIG.pauseAfterFailedPage
                    ) {

                        await handleFailedPage(
                            "Next page did not appear before timeout."
                        );


                        continue;
                    }


                    break;
                }


                /* --------------------------------------------------------
                   UNKNOWN FAILURE
                   -------------------------------------------------------- */

                await handleFailedPage(
                    "The page did not change."
                );
            }


        } catch (error) {

            STATE.lastError =
                error;


            console.error(
                "[DM Collector] Fatal error:",
                error
            );


            setStatus(
                `ERROR: ${
                    error.message ||
                    error
                }`
            );


        } finally {

            STATE.running =
                false;


            updateGui();
        }
    }


    /* ====================================================================
       ========================= CONSOLE API =============================
       ====================================================================

       Optional emergency controls.

       You can type these into the console:

           DMCollector.pause()

           DMCollector.resume()

           DMCollector.stop()

           DMCollector.exportJSON()

           DMCollector.exportJSONL()

           DMCollector.state()

       ==================================================================== */


    window.DMCollector = {

        pause() {

            STATE.paused =
                true;


            setStatus(
                "Paused from console."
            );


            updateGui();
        },


        resume() {

            STATE.paused =
                false;


            setStatus(
                "Resumed from console."
            );


            updateGui();
        },


        stop() {

            stopCollector(
                "Stopped from console."
            );
        },


        exportJSON,

        exportJSONL,


        state() {

            return {
                ...STATE,
                eta:
                    getEtaText(),
                averagePageTime:
                    getAverageCycleMs()
            };
        }
    };


    /* ====================================================================
       ============================== START ===============================
       ==================================================================== */


    createGui();


    runCollector();


    console.log(
        "%c[DM Collector v5.1]%c Started.",
        "font-weight:bold;",
        ""
    );


    console.log(
        "[DM Collector v5.1] Configuration:",
        CONFIG
    );


    console.log(
        "[DM Collector v5.1] Existing IndexedDB database:",
        CONFIG.databaseName
    );


})();
