    /* ====================================================================
       ============================ DRAGGING ==============================
       ==================================================================== */


    function guiPositionKey() {

        return (
            "discord-dm-collector-v51-position-" +
            CONFIG.databaseName
        );
    }


    function saveGuiPosition(
        panel
    ) {

        if (
            !CONFIG.rememberGuiPosition
        ) {

            return;
        }


        try {

            localStorage.setItem(
                guiPositionKey(),
                JSON.stringify({
                    left:
                        panel.offsetLeft,

                    top:
                        panel.offsetTop
                })
            );

        } catch (_) {}
    }


    function restoreGuiPosition(
        panel
    ) {

        if (
            !CONFIG.rememberGuiPosition
        ) {

            return;
        }


        try {

            const raw =
                localStorage.getItem(
                    guiPositionKey()
                );


            if (!raw) {
                return;
            }


            const position =
                JSON.parse(
                    raw
                );


            if (
                typeof position.left !==
                    "number" ||
                typeof position.top !==
                    "number"
            ) {

                return;
            }


            panel.style.left =
                `${clamp(
                    position.left,
                    0,
                    window.innerWidth -
                        panel.offsetWidth
                )}px`;


            panel.style.top =
                `${clamp(
                    position.top,
                    0,
                    window.innerHeight -
                        panel.offsetHeight
                )}px`;


            panel.style.right =
                "auto";

        } catch (_) {}
    }


    function makeDraggable(
        panel,
        handle
    ) {

        let dragging =
            false;


        let startX =
            0;


        let startY =
            0;


        let startLeft =
            0;


        let startTop =
            0;


        handle.addEventListener(
            "pointerdown",
            event => {

                if (
                    event.button !== 0
                ) {

                    return;
                }


                dragging =
                    true;


                const rect =
                    panel.getBoundingClientRect();


                startX =
                    event.clientX;


                startY =
                    event.clientY;


                startLeft =
                    rect.left;


                startTop =
                    rect.top;


                panel.style.left =
                    `${rect.left}px`;


                panel.style.top =
                    `${rect.top}px`;


                panel.style.right =
                    "auto";


                try {

                    handle.setPointerCapture(
                        event.pointerId
                    );

                } catch (_) {}


                event.preventDefault();
            }
        );


        handle.addEventListener(
            "pointermove",
            event => {

                if (!dragging) {

                    return;
                }


                const left =
                    clamp(
                        startLeft +
                            (
                                event.clientX -
                                startX
                            ),
                        0,
                        window.innerWidth -
                            panel.offsetWidth
                    );


                const top =
                    clamp(
                        startTop +
                            (
                                event.clientY -
                                startY
                            ),
                        0,
                        window.innerHeight -
                            panel.offsetHeight
                    );


                panel.style.left =
                    `${left}px`;


                panel.style.top =
                    `${top}px`;
            }
        );


        handle.addEventListener(
            "pointerup",
            event => {

                dragging =
                    false;


                try {

                    handle.releasePointerCapture(
                        event.pointerId
                    );

                } catch (_) {}


                saveGuiPosition(
                    panel
                );
            }
        );


        handle.addEventListener(
            "pointercancel",
            () => {

                dragging =
                    false;


                saveGuiPosition(
                    panel
                );
            }
        );
    }


